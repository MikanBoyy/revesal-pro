// @function Efficiency Ratioを算出する
// @param sourceSeries 計算対象の価格系列
// @param period ER算出期間
// @return ER値（0.0-1.0）
f_calc_efficiency_ratio(sourceSeries, period) =>
	float direction = math.abs(sourceSeries - sourceSeries[period])
	float volatility = ta.sma(math.abs(sourceSeries - sourceSeries[1]), period) * period
	float er = volatility == 0.0 ? 0.0 : direction / volatility
	er

// @function ATRとERから動的な反転閾値（価格幅）を算出する
// @param atrValue ATR値
// @param erValue ER値（0.0-1.0）
// @param atrMultiplier ATR乗数k
// @return 反転閾値（価格幅）
f_calc_dynamic_threshold_price(atrValue, erValue, atrMultiplier) =>
	// Why: レンジで閾値を狭めると小さな往復でLH/HLが量産され、TCが連続する。
	//      ERが低いほど反転幅を広げ、ノイズではなく明確な値動きだけを確定させる。
	float dynamicMultiplier = 1.4 - (erValue * 0.8)
	float thresholdPrice = (atrMultiplier * atrValue) * dynamicMultiplier
	thresholdPrice

// @function 現在時間軸に応じた上位足タイムフレーム文字列を返す
// @param なし
// @return 上位足のタイムフレーム文字列（request.security用）
// Why: 1分足は15分、15分足は60分、60分足は4時間、4時間足は日、日足は週を上位足として参照し、直近上位トレンドを捉える
f_get_htf_timeframe() =>
	string htfTimeframe = "W"
	if timeframe.isseconds or timeframe.isintraday
		// 秒足・分足・時間足を分単位に正規化して判定（秒足は0扱いで15分足へ）
		int currentMinutes = timeframe.isseconds ? 0 : timeframe.multiplier
		htfTimeframe := currentMinutes < 15 ? "15" : currentMinutes < 60 ? "60" : currentMinutes < 240 ? "240" : "D"
	else if timeframe.isdaily
		htfTimeframe := "W"
	htfTimeframe

