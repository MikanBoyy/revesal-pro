// @function 水平線の描画スタイルを状態に応じて更新する
// @param targetLine 更新対象ライン
// @param lineState ライン状態（Active/Flipped/Broken）
// @param lineRole ライン役割（レジ/サポ）
// @param resistanceColor レジスタンス色
// @param supportColor サポート色
// @param brokenColor 完全ブレイク色
// @param isVisible チャート上に可視表示するか
// @return なし
f_apply_sr_line_style(targetLine, lineState, lineRole, resistanceColor, supportColor, brokenColor, isVisible) =>
    appliedStyle = lineState == 3 ? line.style_dotted : line.style_solid
    color baseColor = lineState == 3 ? brokenColor : (lineRole == 1 ? resistanceColor : supportColor)
    color appliedColor = isVisible ? baseColor : color.new(baseColor, 100)
    // Why: 状態差を線幅でも表現する。Active/Flipped=2で現役ラインを強調し、Broken=1で細く引き締めて点線・減光と合わせ三段階の識別性を確保する
    appliedWidth = lineState == 3 ? 1 : 2
    line.set_style(targetLine, appliedStyle)
    line.set_color(targetLine, appliedColor)
    line.set_width(targetLine, appliedWidth)

// @function 指定バー範囲の平均出来高を算出する
// @param startBar 開始バーインデックス（含む）
// @param endBar 終了バーインデックス（含む）
// @return 平均出来高（算出不能時はna）
f_calc_average_volume_between_bars(startBar, endBar) =>
    float volumeSum = 0.0
    int volumeCount = 0
    if not na(startBar) and not na(endBar) and endBar >= startBar
        for barCursor = startBar to endBar
            int historyIndex = bar_index - barCursor
            if historyIndex >= 0
                volumeSum := volumeSum + volume[historyIndex]
                volumeCount := volumeCount + 1
    float averageVolume = volumeCount > 0 ? volumeSum / volumeCount : na
    averageVolume

// @function ボックス配列へ要素を追加し、上限超過分を削除する
// @param targetBoxes ボックス配列
// @param newBox 追加するボックス
// @param maxBoxCount 保持上限
// @return なし
f_append_box_with_cap(targetBoxes, newBox, maxBoxCount) =>
    array.push(targetBoxes, newBox)
    if array.size(targetBoxes) > maxBoxCount
        box oldBox = array.shift(targetBoxes)
        box.delete(oldBox)

// @function レジーム転換専用ライン配列へ要素を追加し、上限超過分を削除する
// @param reversalLines レジーム転換専用ライン配列
// @param newReversalLine 追加する転換ライン
// @param maxReversalLinesCount 保持上限
// @return なし
f_append_reversal_line_with_cap(reversalLines, newReversalLine, maxReversalLinesCount) =>
    array.push(reversalLines, newReversalLine)
    if array.size(reversalLines) > maxReversalLinesCount
        line oldReversalLine = array.shift(reversalLines)
        line.delete(oldReversalLine)

// @type レジサポ水平線の追跡情報を1要素に集約する
type SRLine
    line ln
    float price
    int role
    int state
    int createdBar
    int brokenBar
    bool watchArmed
    int watchFirstBar
    float watchFirstExtreme
    bool watchInstitutionalBacked
    float watchRangeVolumeAverage
    bool isVisible
    bool isRegimeCandidate

// @type 確定したZigZagピボットのクラスタ探索用情報
type ConfirmedPivot
    float price
    int barIndex
    int pivotType

// @type ピボットクラスタ型疑似OBの属性情報を1要素に集約する構造体
type PseudoOrderBlock
    box bx
    float topPrice
    float bottomPrice
    int direction
    int createdBar
    int confirmedBar
    int state
    int touchCount
    bool wasInsideZone
    int pivotCount
    float clusterVolumeAvg
    bool extensionStopped

// @function 指定インデックスの疑似OBを削除する
// @param pseudoOrderBlocks PseudoOrderBlock配列
// @param targetIndex 削除対象インデックス
// @return なし
f_delete_pseudo_order_block_at(pseudoOrderBlocks, targetIndex) =>
    PseudoOrderBlock targetOrderBlock = array.get(pseudoOrderBlocks, targetIndex)
    box.delete(targetOrderBlock.bx)
    array.remove(pseudoOrderBlocks, targetIndex)

// @function 疑似OB配列を上限本数に収める
// @param pseudoOrderBlocks PseudoOrderBlock配列
// @param maxPseudoOrderBlocksCount 保持上限
// @return なし
f_trim_pseudo_order_blocks_with_cap(pseudoOrderBlocks, maxPseudoOrderBlocksCount) =>
    while array.size(pseudoOrderBlocks) > maxPseudoOrderBlocksCount
        f_delete_pseudo_order_block_at(pseudoOrderBlocks, 0)

// @function 同方向かつ価格帯が重なる有効な疑似OBの有無を判定する
// @param pseudoOrderBlocks PseudoOrderBlock配列
// @param candidateTopPrice 候補上限
// @param candidateBottomPrice 候補下限
// @param candidateDirection 候補方向（1=Support、-1=Resistance）
// @param activeState Active状態値
// @param mitigatedState Mitigated状態値
// @return 重複する有効ゾーンがある場合はtrue
f_has_overlapping_pseudo_order_block(pseudoOrderBlocks, candidateTopPrice, candidateBottomPrice, candidateDirection, activeState, mitigatedState) =>
    bool hasOverlap = false
    int orderBlockIndex = array.size(pseudoOrderBlocks) - 1
    while orderBlockIndex >= 0
        PseudoOrderBlock currentOrderBlock = array.get(pseudoOrderBlocks, orderBlockIndex)
        bool isLiveZone = currentOrderBlock.state == activeState or currentOrderBlock.state == mitigatedState
        bool sameDirection = currentOrderBlock.direction == candidateDirection
        bool pricesOverlap = candidateBottomPrice <= currentOrderBlock.topPrice and candidateTopPrice >= currentOrderBlock.bottomPrice
        if isLiveZone and sameDirection and pricesOverlap
            hasOverlap := true
        orderBlockIndex := orderBlockIndex - 1
    hasOverlap

// @function クラスタ候補から疑似OBを生成する
// @param confirmedPivots 確定ピボット履歴
// @param pseudoOrderBlocks PseudoOrderBlock配列
// @param latestPivotType 最新ピボット種別（高値=1、安値=-1）
// @param clusterWidthPrice 価格クラスタ幅
// @param minimumBounceBars 最小反発バー数
// @param volumeMultiplier 出来高倍率閾値
// @param boundaryMode ゾーン境界モード
// @param wickBoundaryMode ヒゲを含むモード名
// @param maximumWidthAtr ゾーン幅上限ATR倍率
// @param minimumWidthAtr ゾーン幅下限ATR倍率
// @param atrValue 現在ATR
// @param volumeSma20 出来高SMA20
// @param supportColor Support色
// @param resistanceColor Resistance色
// @param activeAlpha Active時透明度
// @param activeState Active状態値
// @param mitigatedState Mitigated状態値
// @param maxPseudoOrderBlocksCount 保持上限
// @return なし
f_create_pseudo_order_block_from_cluster(confirmedPivots, pseudoOrderBlocks, latestPivotType, clusterWidthPrice, minimumBounceBars, volumeMultiplier, boundaryMode, wickBoundaryMode, maximumWidthAtr, minimumWidthAtr, atrValue, volumeSma20, supportColor, resistanceColor, activeAlpha, activeState, mitigatedState, maxPseudoOrderBlocksCount) =>
    int pivotHistoryCount = array.size(confirmedPivots)
    bool canEvaluateCluster = pivotHistoryCount >= 2 and not na(clusterWidthPrice) and clusterWidthPrice > 0 and not na(atrValue)
    if canEvaluateCluster
        ConfirmedPivot latestPivot = array.get(confirmedPivots, pivotHistoryCount - 1)
        int pseudoOrderBlockDirection = latestPivotType == -1 ? 1 : -1
        float seedTopPrice = latestPivot.price + clusterWidthPrice
        float seedBottomPrice = latestPivot.price - clusterWidthPrice
        int clusterPivotCount = 0
        int oldestClusterBar = latestPivot.barIndex
        float zoneTopPrice = na
        float zoneBottomPrice = na

        int pivotIndex = pivotHistoryCount - 1
        while pivotIndex >= 0
            ConfirmedPivot clusterPivot = array.get(confirmedPivots, pivotIndex)
            bool belongsToCluster = math.abs(clusterPivot.price - latestPivot.price) <= clusterWidthPrice
            if belongsToCluster
                // Why: ピボット履歴のバー位置は可変であり、OHLCの動的履歴参照は必要参照長を確定できずPineの実行制限に触れる。
                //      ピボット価格を境界候補とし、固定100バー内に制限した反発足だけで足の高安値または実体端を広げる。
                zoneTopPrice := na(zoneTopPrice) ? clusterPivot.price : math.max(zoneTopPrice, clusterPivot.price)
                zoneBottomPrice := na(zoneBottomPrice) ? clusterPivot.price : math.min(zoneBottomPrice, clusterPivot.price)
                oldestClusterBar := math.min(oldestClusterBar, clusterPivot.barIndex)
                clusterPivotCount := clusterPivotCount + 1
            pivotIndex := pivotIndex - 1

        int bounceCount = 0
        float bounceVolumeSum = 0.0
        float bounceVolumeSmaSum = 0.0
        int scanLimit = math.min(100, bar_index)
        for historyOffset = 0 to scanLimit
            bool touchesSeedZone = high[historyOffset] >= seedBottomPrice and low[historyOffset] <= seedTopPrice
            // Why: 反発は一足で帯外まで戻る場面だけでなく、帯内で価格を維持してから反転する場面にも現れる。
            //      終値が反対側へ確定抜けしていないことを条件に、もみ合いを経た反発を反映する。
            bool isSupportBounce = pseudoOrderBlockDirection == 1 and touchesSeedZone and close[historyOffset] >= seedBottomPrice
            bool isResistanceBounce = pseudoOrderBlockDirection == -1 and touchesSeedZone and close[historyOffset] <= seedTopPrice
            if isSupportBounce or isResistanceBounce
                float rawBounceTopPrice = boundaryMode == wickBoundaryMode ? high[historyOffset] : math.max(open[historyOffset], close[historyOffset])
                float rawBounceBottomPrice = boundaryMode == wickBoundaryMode ? low[historyOffset] : math.min(open[historyOffset], close[historyOffset])
                float bounceTopPrice = math.min(rawBounceTopPrice, seedTopPrice)
                float bounceBottomPrice = math.max(rawBounceBottomPrice, seedBottomPrice)
                bool hasBoundaryContribution = bounceTopPrice >= bounceBottomPrice
                // Why: 反発後に伸びた実体・ヒゲまでゾーンに含めると、複数反発で幅が肥大し上限フィルタにより候補が全棄却される。
                //      クラスタ帯と重なる価格部分だけを境界に寄与させ、反発の起点を監視帯として維持する。
                if hasBoundaryContribution
                    zoneTopPrice := na(zoneTopPrice) ? bounceTopPrice : math.max(zoneTopPrice, bounceTopPrice)
                    zoneBottomPrice := na(zoneBottomPrice) ? bounceBottomPrice : math.min(zoneBottomPrice, bounceBottomPrice)
                oldestClusterBar := math.min(oldestClusterBar, bar_index - historyOffset)
                bounceCount := bounceCount + 1
                bounceVolumeSum := bounceVolumeSum + volume[historyOffset]
                bounceVolumeSmaSum := bounceVolumeSmaSum + volumeSma20[historyOffset]

        float clusterVolumeAverage = bounceCount > 0 ? bounceVolumeSum / bounceCount : na
        float bounceVolumeSmaAverage = bounceCount > 0 ? bounceVolumeSmaSum / bounceCount : na
        bool hasCluster = clusterPivotCount >= 2
        bool hasRequiredBounces = bounceCount >= minimumBounceBars
        bool hasVolumeData = not na(volume) and volume > 0
        bool hasRequiredVolume = not hasVolumeData or (not na(clusterVolumeAverage) and not na(bounceVolumeSmaAverage) and clusterVolumeAverage >= bounceVolumeSmaAverage * volumeMultiplier)
        bool hasZoneBounds = not na(zoneTopPrice) and not na(zoneBottomPrice) and zoneTopPrice >= zoneBottomPrice

        if hasCluster and hasRequiredBounces and hasRequiredVolume and hasZoneBounds
            float zoneWidth = zoneTopPrice - zoneBottomPrice
            bool exceedsMaximumWidth = zoneWidth > atrValue * maximumWidthAtr
            if not exceedsMaximumWidth
                float minimumZoneWidth = atrValue * minimumWidthAtr
                if zoneWidth < minimumZoneWidth
                    float zoneCenterPrice = (zoneTopPrice + zoneBottomPrice) / 2.0
                    zoneTopPrice := zoneCenterPrice + minimumZoneWidth / 2.0
                    zoneBottomPrice := zoneCenterPrice - minimumZoneWidth / 2.0

                bool hasDuplicateZone = f_has_overlapping_pseudo_order_block(pseudoOrderBlocks, zoneTopPrice, zoneBottomPrice, pseudoOrderBlockDirection, activeState, mitigatedState)
                if not hasDuplicateZone
                    color zoneColor = pseudoOrderBlockDirection == 1 ? supportColor : resistanceColor
                    box pseudoOrderBlockBox = box.new(oldestClusterBar, zoneTopPrice, bar_index, zoneBottomPrice, xloc=xloc.bar_index, bgcolor=color.new(zoneColor, activeAlpha), border_width=1, border_color=color.new(zoneColor, 0))
                    PseudoOrderBlock newPseudoOrderBlock = PseudoOrderBlock.new(pseudoOrderBlockBox, zoneTopPrice, zoneBottomPrice, pseudoOrderBlockDirection, oldestClusterBar, bar_index, activeState, 0, false, clusterPivotCount, clusterVolumeAverage, false)
                    array.push(pseudoOrderBlocks, newPseudoOrderBlock)
                    f_trim_pseudo_order_blocks_with_cap(pseudoOrderBlocks, maxPseudoOrderBlocksCount)

// @function 疑似OB配列を更新し、Mitigated/Broken/Expiredを反映する
// @param pseudoOrderBlocks PseudoOrderBlock配列
// @param activeState Active状態値
// @param mitigatedState Mitigated状態値
// @param brokenState Broken状態値
// @param expiredState Expired状態値
// @param supportColor Support色
// @param resistanceColor Resistance色
// @param mitigatedAlpha Mitigated時透明度
// @param maxAgeBars 寿命バー数
// @param expiryAction 寿命到達時の処理
// @param expiryDeleteAction 寿命到達時に削除するモード名
// @return なし
f_update_pseudo_order_blocks(pseudoOrderBlocks, activeState, mitigatedState, brokenState, expiredState, supportColor, resistanceColor, mitigatedAlpha, maxAgeBars, expiryAction, expiryDeleteAction) =>
    int orderBlockIndex = array.size(pseudoOrderBlocks) - 1
    while orderBlockIndex >= 0
        PseudoOrderBlock currentOrderBlock = array.get(pseudoOrderBlocks, orderBlockIndex)
        bool isSupportZone = currentOrderBlock.direction == 1
        bool isBroken = isSupportZone ? close < currentOrderBlock.bottomPrice : close > currentOrderBlock.topPrice
        bool isExpired = maxAgeBars > 0 and bar_index - currentOrderBlock.confirmedBar >= maxAgeBars
        bool isActiveState = currentOrderBlock.state == activeState or currentOrderBlock.state == mitigatedState

        if isActiveState and isBroken
            currentOrderBlock.state := brokenState
            currentOrderBlock.extensionStopped := true
            box.set_right(currentOrderBlock.bx, bar_index)
            box.set_bgcolor(currentOrderBlock.bx, color.new(isSupportZone ? supportColor : resistanceColor, 96))
            box.set_border_style(currentOrderBlock.bx, line.style_dotted)
            array.set(pseudoOrderBlocks, orderBlockIndex, currentOrderBlock)
        else if isActiveState and isExpired
            if expiryAction == expiryDeleteAction
                f_delete_pseudo_order_block_at(pseudoOrderBlocks, orderBlockIndex)
            else
                currentOrderBlock.state := expiredState
                currentOrderBlock.extensionStopped := true
                box.set_right(currentOrderBlock.bx, bar_index)
                box.set_bgcolor(currentOrderBlock.bx, color.new(isSupportZone ? supportColor : resistanceColor, 96))
                box.set_border_style(currentOrderBlock.bx, line.style_dotted)
                array.set(pseudoOrderBlocks, orderBlockIndex, currentOrderBlock)
        else if isActiveState
            bool isInsideZone = high >= currentOrderBlock.bottomPrice and low <= currentOrderBlock.topPrice
            bool canCountTouch = bar_index > currentOrderBlock.confirmedBar
            bool touchEntry = canCountTouch and isInsideZone and not currentOrderBlock.wasInsideZone
            if not currentOrderBlock.extensionStopped
                box.set_right(currentOrderBlock.bx, bar_index)
            if touchEntry
                currentOrderBlock.touchCount := currentOrderBlock.touchCount + 1
                currentOrderBlock.state := mitigatedState
                box.set_bgcolor(currentOrderBlock.bx, color.new(isSupportZone ? supportColor : resistanceColor, mitigatedAlpha))
                box.set_border_style(currentOrderBlock.bx, line.style_dotted)
            currentOrderBlock.wasInsideZone := isInsideZone
            array.set(pseudoOrderBlocks, orderBlockIndex, currentOrderBlock)
        orderBlockIndex := orderBlockIndex - 1

// @function 水平線管理配列から指定インデックスの要素を削除する
// @param horizontalLines SRLine配列
// @param targetIndex 削除対象インデックス
// @return なし
f_delete_sr_line_at(horizontalLines, targetIndex) =>
    SRLine targetLine = array.get(horizontalLines, targetIndex)
    line.delete(targetLine.ln)
    array.remove(horizontalLines, targetIndex)

// @function レジサポ配列を更新し、レジーム転換シグナルを評価する
// @param horizontalLines SRLine配列
// @param reversalLines レジーム転換専用ライン配列
// @param expiryBarsAfterBreak Broken後の削除猶予本数
// @param srSecondBreakConfirmMode 2本目確定条件
// @param srConfirmModeFirstExtreme 足1極値更新モード名
// @param srStateActive Active状態値
// @param srStateFlipped Flipped状態値
// @param srStateBroken Broken状態値
// @param srRoleResistance レジスタンス役割値
// @param srRoleSupport サポート役割値
// @param regimeBullish 強気レジーム値
// @param regimeBearish 弱気レジーム値
// @param currentRegime 現在レジーム値
// @param pivotSourceHigh ピボット判定高値
// @param pivotSourceLow ピボット判定安値
// @param resistanceLineColor レジ色
// @param supportLineColor サポ色
// @param brokenLineColor broken色
// @param reversalLineColor 転換ライン色
// @param reversalLineWidth 転換ライン太さ
// @param maxReversalLinesCount 転換ライン保持上限
// @param isInstitutionalSignal 機関性シグナル有無
// @param barHasCoreTimeFvg 現在バーのコアタイムFVG有無
// @return [転換確定, プレミアム, 強気転換, 転換価格, 転換時刻, 更新後レジーム]
f_update_sr_lines(horizontalLines, reversalLines, expiryBarsAfterBreak, srSecondBreakConfirmMode, srConfirmModeFirstExtreme, srStateActive, srStateFlipped, srStateBroken, srRoleResistance, srRoleSupport, regimeBullish, regimeBearish, currentRegime, pivotSourceHigh, pivotSourceLow, resistanceLineColor, supportLineColor, brokenLineColor, reversalLineColor, reversalLineWidth, maxReversalLinesCount, isInstitutionalSignal, barHasCoreTimeFvg) =>
    bool regimeShiftConfirmedSignal = false
    bool regimeShiftIsPremium = false
    bool regimeShiftIsBullish = false
    float regimeShiftSignalPrice = na
    int regimeShiftSignalTime = na
    int nextRegimeState = currentRegime

    int horizontalIndex = array.size(horizontalLines) - 1
    while horizontalIndex >= 0
        SRLine currentLine = array.get(horizontalLines, horizontalIndex)
        int currentState = currentLine.state
        int currentRole = currentLine.role
        float currentPrice = currentLine.price
        bool watchActive = currentLine.watchArmed
        int watchStartBar = currentLine.watchFirstBar
        float watchFirstExtreme = currentLine.watchFirstExtreme
        bool isDeleted = false
        bool shouldMoveToReversalLines = false

        if currentState == srStateBroken
            int brokenBarIndex = currentLine.brokenBar
            bool hasExpiry = not na(brokenBarIndex) and bar_index - brokenBarIndex >= expiryBarsAfterBreak
            if hasExpiry
                f_delete_sr_line_at(horizontalLines, horizontalIndex)
                isDeleted := true

        if not isDeleted and currentState != srStateBroken
            if not watchActive
                bool firstBreakDetected = (currentRole == srRoleResistance and close > currentPrice) or (currentRole == srRoleSupport and close < currentPrice)
                if firstBreakDetected
                    float storedExtreme = currentRole == srRoleResistance ? pivotSourceHigh : pivotSourceLow
                    float rangeAverageVolume = f_calc_average_volume_between_bars(currentLine.createdBar, bar_index - 1)
                    currentLine.watchArmed := true
                    currentLine.watchFirstBar := bar_index
                    currentLine.watchFirstExtreme := storedExtreme
                    currentLine.watchInstitutionalBacked := isInstitutionalSignal or barHasCoreTimeFvg
                    currentLine.watchRangeVolumeAverage := rangeAverageVolume
            else
                bool isNextBar = not na(watchStartBar) and bar_index == watchStartBar + 1
                bool isTimingMiss = na(watchStartBar) or bar_index > watchStartBar + 1
                bool breakConfirmed = false
                bool volumeBacked = false
                bool institutionalBackedBreak = currentLine.watchInstitutionalBacked or barHasCoreTimeFvg

                if isNextBar
                    bool confirmByFirstExtreme = false
                    bool confirmByLinePrice = false
                    if currentRole == srRoleResistance
                        confirmByFirstExtreme := close > watchFirstExtreme
                        confirmByLinePrice := close > currentPrice
                    else
                        confirmByFirstExtreme := close < watchFirstExtreme
                        confirmByLinePrice := close < currentPrice
                    breakConfirmed := srSecondBreakConfirmMode == srConfirmModeFirstExtreme ? confirmByFirstExtreme : confirmByLinePrice
                    float breakAverageVolume = f_calc_average_volume_between_bars(watchStartBar, bar_index)
                    volumeBacked := not na(currentLine.watchRangeVolumeAverage) and not na(breakAverageVolume) and breakAverageVolume > currentLine.watchRangeVolumeAverage

                if breakConfirmed
                    int transitionedState = currentState
                    int transitionedRole = currentRole
                    if currentState == srStateActive
                        transitionedState := srStateFlipped
                        transitionedRole := currentRole == srRoleResistance ? srRoleSupport : srRoleResistance
                    else
                        transitionedState := srStateBroken
                    currentLine.state := transitionedState
                    currentLine.role := transitionedRole
                    if transitionedState == srStateBroken
                        currentLine.brokenBar := bar_index
                    line.set_extend(currentLine.ln, extend.none)
                    line.set_x2(currentLine.ln, time)
                    f_apply_sr_line_style(currentLine.ln, transitionedState, transitionedRole, resistanceLineColor, supportLineColor, brokenLineColor, currentLine.isVisible)

                    if transitionedState == srStateFlipped and currentLine.isRegimeCandidate and not regimeShiftConfirmedSignal
                        bool isBullishBreak = currentRole == srRoleResistance
                        int expectedRegime = isBullishBreak ? regimeBullish : regimeBearish
                        bool isNewRegimeShift = nextRegimeState != expectedRegime
                        if isNewRegimeShift
                            bool isPremiumSignal = institutionalBackedBreak or volumeBacked
                            line.set_style(currentLine.ln, line.style_solid)
                            line.set_color(currentLine.ln, reversalLineColor)
                            line.set_width(currentLine.ln, reversalLineWidth)
                            f_append_reversal_line_with_cap(reversalLines, currentLine.ln, maxReversalLinesCount)
                            shouldMoveToReversalLines := true
                            nextRegimeState := expectedRegime
                            regimeShiftConfirmedSignal := true
                            regimeShiftIsPremium := isPremiumSignal
                            regimeShiftIsBullish := isBullishBreak
                            regimeShiftSignalPrice := currentPrice
                            regimeShiftSignalTime := time

                bool shouldResetWatch = breakConfirmed or isNextBar or isTimingMiss
                if shouldResetWatch
                    currentLine.watchArmed := false
                    currentLine.watchFirstBar := na
                    currentLine.watchFirstExtreme := na
                    currentLine.watchInstitutionalBacked := false
                    currentLine.watchRangeVolumeAverage := na

                if shouldMoveToReversalLines
                    array.remove(horizontalLines, horizontalIndex)
                else
                    array.set(horizontalLines, horizontalIndex, currentLine)

        horizontalIndex := horizontalIndex - 1

    [regimeShiftConfirmedSignal, regimeShiftIsPremium, regimeShiftIsBullish, regimeShiftSignalPrice, regimeShiftSignalTime, nextRegimeState]
