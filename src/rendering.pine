string ZZ_TEXT_ER = "ER"
string ZZ_TEXT_FILTER = "確定モード"
string ZZ_TEXT_DIRECTION = "方向"
string ZZ_TEXT_FILTER_FAST = "1本抜け即時"
string ZZ_TEXT_FILTER_STRICT = "2本連続確定"
string ZZ_TEXT_DIRECTION_UP = "上方向"
string ZZ_TEXT_DIRECTION_DOWN = "下方向"
string ZZ_TEXT_DIRECTION_NONE = "未確定"
int ZZ_HUD_BG_HEADER_ALPHA = 70
int ZZ_HUD_BG_VALUE_ALPHA = 85
int ZZ_PIVOT_TYPE_UP = 1
int ZZ_PIVOT_TYPE_DOWN = -1

// @function シグナルラベルを上限制御付きで追加する
// @param signalLabels シグナルラベル配列
// @param newSignalLabel 新規ラベル
// @param maxSignalLabels 保持上限
// @return なし
f_append_signal_label_with_cap(signalLabels, newSignalLabel, maxSignalLabels) =>
	array.push(signalLabels, newSignalLabel)
	if array.size(signalLabels) > maxSignalLabels
		label oldSignalLabel = array.shift(signalLabels)
		label.delete(oldSignalLabel)

// @function 方向性HUDとパフォーマンスHUDを1テーブルに合体して描画する
// @param hudTable 合体HUDテーブル（2列x8行）
// @param showDirectionHud 方向性HUDの表示有無
// @param showPerformanceHud パフォーマンスHUDの表示有無
// @param isStrongTrend ER強弱判定
// @param erValue ER値
// @param confirmedPivotType 最新確定方向
// @param totalTradeCount 総トレード数（END発生回数）
// @param winTradeCount 勝ちトレード数
// @param grossProfitTicks 総利益（ティック換算）
// @param grossLossTicks 総損失（ティック換算）
// @param cumulativePnlTicks 累積損益（ティック換算）
// @param positionDirection 保有方向（1=ロング、-1=ショート、0=なし）
// @param openPositionCount 保有ポジション数
// @param maxPyramidingCount 最大ピラミッティング数
// @param htfTimeframe 上位足タイムフレーム文字列
// @param htfBullish 上位足が強気か
// @param htfBearish 上位足が弱気か
// @param htfErValue 上位足ER値
// @param useHtfFilter 上位足フィルタ有効か
// @param useDynamicRr 動的RR有効か（HUD表示の動的/固定の併記に使用）
// @param dynamicRrLong ロング適用RR（動的RR有効時は算出値、無効時は固定RR）
// @param dynamicRrShort ショート適用RR（動的RR有効時は算出値、無効時は固定RR）
// @param fixedRr 固定RR（動的RR無効時の表示用）
// @return なし
f_render_combined_hud(hudTable, showDirectionHud, showPerformanceHud, isStrongTrend, erValue, confirmedPivotType, totalTradeCount, winTradeCount, grossProfitTicks, grossLossTicks, cumulativePnlTicks, positionDirection, openPositionCount, maxPyramidingCount, htfTimeframe, htfBullish, htfBearish, htfErValue, useHtfFilter, useDynamicRr, dynamicRrLong, dynamicRrShort, fixedRr) =>
	// 行0-3: 方向性HUD。非表示時は当該行のみ消去し、他ブロックの表示を維持する
	if showDirectionHud
		string hudErText = (isStrongTrend ? "強い" : "弱い") + " (ER=" + str.tostring(erValue, "#.###") + ")"
		string hudFilterText = isStrongTrend ? ZZ_TEXT_FILTER_FAST : ZZ_TEXT_FILTER_STRICT
		string hudDirectionText = confirmedPivotType == ZZ_PIVOT_TYPE_UP ? ZZ_TEXT_DIRECTION_UP : confirmedPivotType == ZZ_PIVOT_TYPE_DOWN ? ZZ_TEXT_DIRECTION_DOWN : ZZ_TEXT_DIRECTION_NONE
		// HTF行: 上位足の時間軸・方向・ER・フィルタ通過可否を一覧化し、フィルタ動作を目視検証可能にする
		// Why: 中立時はフィルタを素通しする仕様のため、HUDでも素通し状態を明示して目視検証しやすくする
		string htfDirText = htfBullish ? "↑強気" : htfBearish ? "↓弱気" : "-中立(素通し)"
		string htfStateText = useHtfFilter ? htfTimeframe + " " + htfDirText + " (ER=" + str.tostring(htfErValue, "#.##") + ")" : "OFF"
		table.cell(hudTable, 0, 0, ZZ_TEXT_ER, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 0, hudErText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 1, ZZ_TEXT_FILTER, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 1, hudFilterText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 2, ZZ_TEXT_DIRECTION, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 2, hudDirectionText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 3, "上位足", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 3, htfStateText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		// RR行: 動的RR有効時は方向別の適用値を併記し、無効時は固定値であることを明示して設定ミスの見落としを防ぐ
		string rrValueText = useDynamicRr ? "L " + str.tostring(dynamicRrLong, "#.##") + " / S " + str.tostring(dynamicRrShort, "#.##") + "（動的）" : str.tostring(fixedRr, "#.##") + "（固定）"
		table.cell(hudTable, 0, 4, "RR", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 4, rrValueText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
	else
		table.clear(hudTable, 0, 0, 1, 4)

	// 行5-8: パフォーマンスHUD。非表示時は当該行のみ消去する
	if showPerformanceHud
		string winRateText = totalTradeCount > 0 ? str.tostring(100.0 * winTradeCount / totalTradeCount, "#.#") + "%" : "-"
		string tradeSummaryText = str.tostring(totalTradeCount) + " / " + winRateText
		// Why: 損失0での除算を避けるためnaを経由し、未成立時はハイフン表示に倒す
		float profitFactorValue = grossLossTicks > 0 ? grossProfitTicks / grossLossTicks : na
		string profitFactorText = na(profitFactorValue) ? "-" : str.tostring(profitFactorValue, "#.##")
		string pnlText = (cumulativePnlTicks >= 0 ? "+" : "") + str.tostring(cumulativePnlTicks, "#") + " ticks"
		string positionCountText = str.tostring(openPositionCount) + "/" + str.tostring(maxPyramidingCount)
		string positionText = positionDirection == 1 ? "L " + positionCountText : positionDirection == -1 ? "S " + positionCountText : "なし"
		table.cell(hudTable, 0, 5, "回数/勝率", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 5, tradeSummaryText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 6, "PF", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 6, profitFactorText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 7, "累積損益", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 7, pnlText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
		table.cell(hudTable, 0, 8, "保有状況", text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
		table.cell(hudTable, 1, 8, positionText, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA))
	else
		table.clear(hudTable, 0, 5, 1, 8)
