string ZZ_TEXT_EXEC_TF = "執行足"
string ZZ_TEXT_HTF = "上位足"
string ZZ_DIRECTION_ARROW_UP = "↑"
string ZZ_DIRECTION_ARROW_DOWN = "↓"
string ZZ_DIRECTION_ARROW_FLAT = "ー"
string ZZ_ER_TIER_BLAZING = "激熱"
string ZZ_ER_TIER_HOT = "熱"
string ZZ_ER_TIER_NEUTRAL = "中立"
string ZZ_ER_TIER_COLD = "冷"
string ZZ_ER_TIER_FREEZING = "極寒"
// Why: ERの5段階閾値。0.45はER強弱閾値の既定値と整合させ、0.30以下は統計的にレンジ相場のER帯、0.60以上は強トレンドの上位分位とみなす
float ZZ_ER_THRESHOLD_BLAZING = 0.60
float ZZ_ER_THRESHOLD_HOT = 0.45
float ZZ_ER_THRESHOLD_NEUTRAL = 0.30
float ZZ_ER_THRESHOLD_COLD = 0.15
int ZZ_HUD_BG_HEADER_ALPHA = 70
int ZZ_HUD_BG_VALUE_ALPHA = 85
// Why: 熱度セルの背景透明度。グレー値セル（85）より濃い45として熱度色の発色を確保する
int ZZ_HUD_BG_HEAT_ALPHA = 45
// Why: ER熱度5段階の背景色。激熱=赤・熱=橙・中立=灰・冷=水色・極寒=青の温度メタファーで直感的に判別できるようにする
color ZZ_ER_COLOR_BLAZING = #EF5350
color ZZ_ER_COLOR_HOT = #FFA726
color ZZ_ER_COLOR_NEUTRAL = #90A4AE
color ZZ_ER_COLOR_COLD = #4FC3F7
color ZZ_ER_COLOR_FREEZING = #7986CB
// Why: HUD矢印の方向色。チャートのZigZagレッグ色（#26A69A/#EF5350）と同系に揃え、色の意味の一貫性を持たせる
color ZZ_DIRECTION_COLOR_UP = #26A69A
color ZZ_DIRECTION_COLOR_DOWN = #EF5350
// Why: バー着色は濃淡なしの不透明単一色とする。旧設計は弱トレンド時の透明度60がキャンドルをかすませ、視認性悪化の主因だったため廃止する
color ZZ_BAR_COLOR_UP = #26A69A
color ZZ_BAR_COLOR_DOWN = #EF5350
// Why: HTF不一致・未判定時のニュートラル色。チャート背景と溶け込みすぎない中彩度グレー
color ZZ_BAR_COLOR_NEUTRAL = #78909C
int ZZ_PIVOT_TYPE_UP = 1
int ZZ_PIVOT_TYPE_DOWN = -1

// @function シグナルラベルを上限制御付きで追加する
// @param signalLabels シグナルラベル配列
// @param newSignalLabel 新規ラベル
// @param maxSignalLabels 保持上限
// @return なし
f_append_signal_label_with_cap(signalLabels, newSignalLabel, maxSignalLabels) =>
	array.push(signalLabels, newSignalLabel)
	if array.size(signalLabels) > maxSignalLabels
		label oldSignalLabel = array.shift(signalLabels)
		label.delete(oldSignalLabel)

// @function タイムフレーム文字列を短縮表記（例: M15, H4, D1）に変換する
// @param timeframeString タイムフレーム文字列（timeframe.period 形式）
// @return 短縮表記文字列。秒換算不能な場合は入力文字列をそのまま返す
f_timeframe_short_label(timeframeString) =>
	int tfSeconds = timeframe.in_seconds(timeframeString)
	string shortLabel = timeframeString
	if not na(tfSeconds)
		if tfSeconds < 86400
			int totalMinutes = int(tfSeconds / 60)
			shortLabel := totalMinutes < 60 ? "M" + str.tostring(totalMinutes) : "H" + str.tostring(int(totalMinutes / 60))
		else if tfSeconds < 604800
			shortLabel := "D" + str.tostring(int(tfSeconds / 86400))
		else if tfSeconds < 2592000
			shortLabel := "W" + str.tostring(int(tfSeconds / 604800))
		else
			shortLabel := "MO" + str.tostring(int(tfSeconds / 2592000))
	shortLabel

// @function ER値を5段階の熱度ラベルに変換する
// @param erValue ER値（0.0〜1.0）
// @return 激熱／熱／中立／冷／極寒のいずれか
f_er_heat_tier_label(erValue) =>
	erValue >= ZZ_ER_THRESHOLD_BLAZING ? ZZ_ER_TIER_BLAZING : erValue >= ZZ_ER_THRESHOLD_HOT ? ZZ_ER_TIER_HOT : erValue >= ZZ_ER_THRESHOLD_NEUTRAL ? ZZ_ER_TIER_NEUTRAL : erValue >= ZZ_ER_THRESHOLD_COLD ? ZZ_ER_TIER_COLD : ZZ_ER_TIER_FREEZING

// @function ER値を5段階の熱度色に変換する
// @param erValue ER値（0.0〜1.0）
// @return 熱度に対応する色（激熱=赤系／熱=橙系／中立=グレー／冷=水色系／極寒=青系）
f_er_heat_tier_color(erValue) =>
	erValue >= ZZ_ER_THRESHOLD_BLAZING ? ZZ_ER_COLOR_BLAZING : erValue >= ZZ_ER_THRESHOLD_HOT ? ZZ_ER_COLOR_HOT : erValue >= ZZ_ER_THRESHOLD_NEUTRAL ? ZZ_ER_COLOR_NEUTRAL : erValue >= ZZ_ER_THRESHOLD_COLD ? ZZ_ER_COLOR_COLD : ZZ_ER_COLOR_FREEZING

// @function バー着色用のトレンド色を算出する
// @param activeLegDirection 現在のアクティブレッグ方向（1=上昇/-1=下降/0=未判定）
// @param htfBullish 上位足が強気か
// @param htfBearish 上位足が弱気か
// @param useHtfFilter HTF不一致判定を有効にするか
// @return バー色。HTF不一致または未判定時はニュートラルグレー
f_calc_bar_color_trend(activeLegDirection, htfBullish, htfBearish, useHtfFilter) =>
	// Why: ユーザー要件「HTFと方向が不一致のときは方向に関わらずグレー寄りで表示」を実現する。
	//      執行足上昇中にHTF弱気、または執行足下降中にHTF強気の場合はニュートラル扱いとする
	bool htfConflict = useHtfFilter and ((activeLegDirection == ZZ_PIVOT_TYPE_UP and htfBearish) or (activeLegDirection == ZZ_PIVOT_TYPE_DOWN and htfBullish))
	color barColor = ZZ_BAR_COLOR_NEUTRAL
	if not htfConflict
		if activeLegDirection == ZZ_PIVOT_TYPE_UP
			barColor := ZZ_BAR_COLOR_UP
		else if activeLegDirection == ZZ_PIVOT_TYPE_DOWN
			barColor := ZZ_BAR_COLOR_DOWN
	barColor

// @function 方向性HUDをテーブルに描画する（執行足/上位足の2行構成）
// @param hudTable HUDテーブル（2列x2行）
// @param executionDirectionType 執行足の最新確定方向（1/-1、その他は横ばい）
// @param erValue 執行足のER値
// @param htfTimeframe 上位足タイムフレーム文字列
// @param htfBullish 上位足が強気か
// @param htfBearish 上位足が弱気か
// @param htfErValue 上位足ER値
// @param useHtfFilter 上位足行を有効表示するか
// @return なし
f_render_direction_hud(hudTable, executionDirectionType, erValue, htfTimeframe, htfBullish, htfBearish, htfErValue, useHtfFilter) =>
	string executionDirectionArrow = executionDirectionType == ZZ_PIVOT_TYPE_UP ? ZZ_DIRECTION_ARROW_UP : executionDirectionType == ZZ_PIVOT_TYPE_DOWN ? ZZ_DIRECTION_ARROW_DOWN : ZZ_DIRECTION_ARROW_FLAT
	string htfDirectionArrow = htfBullish ? ZZ_DIRECTION_ARROW_UP : htfBearish ? ZZ_DIRECTION_ARROW_DOWN : ZZ_DIRECTION_ARROW_FLAT
	string executionRowText = f_timeframe_short_label(timeframe.period) + " " + executionDirectionArrow + " ER:" + f_er_heat_tier_label(erValue)
	string htfRowText = useHtfFilter ? f_timeframe_short_label(htfTimeframe) + " " + htfDirectionArrow + " ER:" + f_er_heat_tier_label(htfErValue) : "OFF"
	// Why: 方向と熱度を一瞥で判別できるよう、矢印テキストは方向色（↑=緑/↓=赤）、値セル背景はER熱度色で塗り分ける。
	//      ヘッダ列はグレーのまま維持し、HUD全体が賑やかになりすぎないようバランスを取る
	color executionTextColor = executionDirectionType == ZZ_PIVOT_TYPE_UP ? ZZ_DIRECTION_COLOR_UP : executionDirectionType == ZZ_PIVOT_TYPE_DOWN ? ZZ_DIRECTION_COLOR_DOWN : color.white
	color htfTextColor = htfBullish ? ZZ_DIRECTION_COLOR_UP : htfBearish ? ZZ_DIRECTION_COLOR_DOWN : color.white
	color executionValueBgColor = color.new(f_er_heat_tier_color(erValue), ZZ_HUD_BG_HEAT_ALPHA)
	color htfValueBgColor = useHtfFilter ? color.new(f_er_heat_tier_color(htfErValue), ZZ_HUD_BG_HEAT_ALPHA) : color.new(color.gray, ZZ_HUD_BG_VALUE_ALPHA)
	color htfValueTextColor = useHtfFilter ? htfTextColor : color.new(color.white, 40)
	table.cell(hudTable, 0, 0, ZZ_TEXT_EXEC_TF, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
	table.cell(hudTable, 1, 0, executionRowText, text_color=executionTextColor, bgcolor=executionValueBgColor)
	table.cell(hudTable, 0, 1, ZZ_TEXT_HTF, text_color=color.white, bgcolor=color.new(color.gray, ZZ_HUD_BG_HEADER_ALPHA))
	table.cell(hudTable, 1, 1, htfRowText, text_color=htfValueTextColor, bgcolor=htfValueBgColor)
